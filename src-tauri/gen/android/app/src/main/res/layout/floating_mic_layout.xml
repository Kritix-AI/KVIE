<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floatingRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="8dp"
    android:orientation="vertical">

    <!-- Partial transcription text label -->
    <TextView
        android:id="@+id/statusLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="6dp"
        android:textSize="11sp"
        android:textColor="#80FFFFFF"
        android:maxLines="2"
        android:ellipsize="end"
        android:visibility="gone"
        android:background="@android:color/transparent"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp" />

    <!-- Active Listening Glow Ring -->
    <View
        android:id="@+id/bubbleGlow"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:layout_gravity="center"
        android:background="@drawable/mic_toolbar_btn_bg"
        android:visibility="gone" />

    <!-- Main Draggable Floating Bubble (54dp) -->
    <FrameLayout
        android:id="@+id/bubbleContainer"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="center"
        android:background="@drawable/floating_bubble_bg"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/bubbleMicIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_btn_speak_now"
            android:contentDescription="Floating Voice Mic" />
    </FrameLayout>

</FrameLayout>
