{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KVIE",
  "version": "2.0.0",
  "identifier": "ai.kritix.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KVIE — Voice Workspace",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      },
      {
        "label": "floating_mic",
        "title": "KVIE Mic",
        "url": "index.html?window=floating",
        "width": 270,
        "height": 58,
        "decorations": false,
        "hiddenTitle": true,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; connect-src 'self' http://localhost:8765 http://127.0.0.1:8765 ws://localhost:8765 ws://127.0.0.1:8765; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.svg",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
